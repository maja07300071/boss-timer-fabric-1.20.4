  "authors": ["maja"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "tw.bosstimer.client.BossTimerClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": "*",
    "minecraft": "~1.20.4",
    "java": ">=17"
  }
}


